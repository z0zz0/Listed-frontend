{
  "name": "listed-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:sandbox": "vite --mode sandbox",
    "build": "tsc -p tsconfig.json && vite build",
    "build:development": "tsc -p tsconfig.json && vite build --mode development",
    "build:sandbox": "tsc -p tsconfig.json && vite build --mode sandbox",
    "build:qa": "tsc -p tsconfig.json && vite build --mode qa",
    "build:prod": "tsc -p tsconfig.json && vite build --mode production",
    "preview": "vite preview",
    "lint:test-locations": "node scripts/check-test-location.mjs",
    "test": "npm run lint:test-locations && vitest",
    "test:run": "npm run lint:test-locations && vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}